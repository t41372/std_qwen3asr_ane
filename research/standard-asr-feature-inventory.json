        "title": "Model Dir",
        "type": "string"
      },
      "max_new_tokens": {
        "default": 256,
        "maximum": 4096,
        "minimum": 1,
        "title": "Max New Tokens",
        "type": "integer"
      },
      "stream_chunk_seconds": {
        "default": 2.0,
        "maximum": 30.0,
        "minimum": 0.1,
        "title": "Stream Chunk Seconds",
        "type": "number"
      },
      "stream_unfixed_chunks": {
        "default": 2,
        "minimum": 0,
        "title": "Stream Unfixed Chunks",
        "type": "integer"
      },
      "stream_unfixed_tokens": {
        "default": 5,
        "minimum": 0,
        "title": "Stream Unfixed Tokens",
        "type": "integer"
      },
      "stream_max_audio_seconds": {
        "default": 30.0,
        "exclusiveMinimum": 0,
        "maximum": 30.0,
        "title": "Stream Max Audio Seconds",
        "type": "number"
      },
