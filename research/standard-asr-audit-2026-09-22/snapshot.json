      "config_schema": {
        "additionalProperties": false,
        "description": "Standard ASR cache defaults, with explicit paths for existing local bundles.",
        "properties": {
          "allow_private_urls": {
            "default": false,
            "description": "Opt-in to relax the SSRF policy so an AudioUrl may target a private/loopback/link-local address (HTTPS is still required). False by default; set True only for a trusted internal endpoint.",
            "title": "Allow Private Urls",
            "type": "boolean"
          },
          "default_candidate_languages": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Default candidate languages.",
            "title": "Default Candidate Languages"
          },
          "default_language": {
            "default": "auto",
            "title": "Default Language",
            "type": "string"
          },
          "download_root": {
            "anyOf": [
              {
                "format": "path",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Root directory for downloaded inference artifacts.",
            "title": "Download Root"
          },
          "draft_bits": {
            "anyOf": [
              {
                "enum": [
                  4,
                  8
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 4,
            "description": "In-memory quantization of the draft decoder; None keeps bf16.",
            "title": "Draft Bits"
          },
          "draft_dir": {
            "anyOf": [
              {
                "format": "path",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional draft bundle from `qwen3-asr-ane build-draft`. When set, batch transcription proposes tokens with Qwen3-ASR 0.6B on the GPU and verifies them on the Neural Engine; output is unchanged. Needs the gpu-draft extra.",
            "title": "Draft Dir"
          },
          "draft_lookahead": {
            "default": 15,
            "maximum": 15,
            "minimum": 1,
            "title": "Draft Lookahead",
            "type": "integer"
          },
          "draft_source_dir": {
            "description": "Pinned 0.6B checkpoint cache, used by explicit draft acquisition.",
            "format": "path",
            "title": "Draft Source Dir",
            "type": "string"
          },
          "engine": {
            "const": "std-qwen3asr-ane",
            "default": "std-qwen3asr-ane",
            "title": "Engine",
            "type": "string"
          },
          "max_new_tokens": {
            "default": 256,
            "maximum": 4096,
            "minimum": 1,
            "title": "Max New Tokens",
            "type": "integer"
          },
          "model_dir": {
            "description": "Bundle path; defaults to the selected profile in the Standard ASR cache.",
            "format": "path",
            "title": "Model Dir",
            "type": "string"
          },
          "profile": {
            "default": "general",
            "enum": [
              "general",
              "short-dictation"
            ],
            "title": "Profile",
            "type": "string"
          },
          "source_dir": {
            "description": "Where `standard-asr pull` keeps the pinned official checkpoint it converts from; reused when present.",
            "format": "path",
            "title": "Source Dir",
            "type": "string"
          },
          "stream_audio_queue_size": {
            "default": 4,
            "maximum": 128,
            "minimum": 1,
            "title": "Stream Audio Queue Size",
            "type": "integer"
          },
          "stream_chunk_seconds": {
            "default": 2.0,
            "maximum": 30.0,
            "minimum": 0.1,
            "title": "Stream Chunk Seconds",
            "type": "number"
          },
          "stream_max_audio_seconds": {
            "default": 180.0,
            "exclusiveMinimum": 0,
            "title": "Stream Max Audio Seconds",
            "type": "number"
          },
          "stream_unfixed_chunks": {
            "default": 2,
            "minimum": 0,
            "title": "Stream Unfixed Chunks",
            "type": "integer"
          },
          "stream_unfixed_tokens": {
            "default": 5,
            "minimum": 0,
            "title": "Stream Unfixed Tokens",
            "type": "integer"
          },
          "strict": {
            "default": true,
            "description": "Unsupported-parameter policy: True=strict, False=best_effort.",
            "title": "Strict",
            "type": "boolean"
          },
          "use_draft": {
            "default": false,
            "description": "Enable the optional GPU draft using its managed cache path.",
            "title": "Use Draft",
            "type": "boolean"
          }
        },
        "title": "Qwen3ASRConfig",
        "type": "object"
      },
      "metadata": {
        "artifacts": {
          "applicable": true,
          "may_acquire_during_inference": false,
          "supports_explicit_acquisition": true
        },
        "x_qwen3asr_streaming": {
          "algorithm": "cumulative_audio_prefix_rollback",
          "audio_feature_reuse": "aligned_stable_stft_and_unclipped_mel_prefix",
          "audio_graph_reuse": "exact_padded_inputs_and_masks",
          "context_limits": "session_configuration_and_bundle_audio_and_decoder_token_capacity",
          "decoder_prefix_reuse": "exact_embeddings_at_token_batch_boundaries",
          "effective_session_audio_limit": "minimum_of_configuration_and_loaded_bundle_duration",
          "persistent_causal_encoder_state": false,
          "segment_rollover_supported": false
        }
      },
